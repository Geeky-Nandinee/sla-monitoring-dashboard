{
  "name": "sla-monitoring-dashboard",
  "version": "1.0.0",
  "description": "SLA Monitoring Dashboard for EarthRe Take-Home Assignment",
  "main": "api/health.js",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node dev-server.js",
    "client": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "inspect": "node scripts/inspect-data.js",
    "init-db": "node scripts/init-db.js",
    "test-pipeline": "node scripts/test-pipeline.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "mysql2": "^3.9.2",
    "papaparse": "^5.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
